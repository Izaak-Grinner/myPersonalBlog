---
import MainLayout from "../../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";
import { convertDateToYYMMDD } from "../../utils/convertDate";

const posts = (await getCollection("article")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<MainLayout title="Article">
    <h1>記事一覧</h1>

    <ul>
        {
            posts.map((post) => (
                <li>
                    <a href={`/article/${post.slug}`}>{post.data.title}</a>
                    <span>{convertDateToYYMMDD(post.data.date)}</span>
                </li>
            ))
        }
    </ul>
</MainLayout>
